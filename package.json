{
  "name": "project-sara",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "dev:web": "npm --workspace @sara/web run dev",
    "build": "npm --workspace @sara/web run build",
    "lint": "biome lint apps/web/src",
    "typecheck": "npm --workspace @sara/web run typecheck",
    "test:web": "node --test apps/web/test/*.test.mjs"
  }
}
