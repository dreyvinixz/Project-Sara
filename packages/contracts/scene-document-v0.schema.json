{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sara:scene-document:v0",
  "title": "SARA SceneDocument v0",
  "description": "Declarative, strictly allowlisted scene format; all text is untrusted plain text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "revision",
    "components",
    "actions",
    "references"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.0"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/text"
          },
          {
            "$ref": "#/$defs/timeSeries"
          },
          {
            "$ref": "#/$defs/newsPanel"
          },
          {
            "$ref": "#/$defs/scene3d"
          },
          {
            "$ref": "#/$defs/control"
          }
        ]
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/selectAction"
          },
          {
            "$ref": "#/$defs/adjustAction"
          },
          {
            "$ref": "#/$defs/navigateAction"
          }
        ]
      }
    },
    "references": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/reference"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "type": {
          "const": "text"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "timeSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "dataStatus",
        "points"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "type": {
          "const": "time_series"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "dataStatus": {
          "enum": [
            "demo",
            "verified"
          ]
        },
        "asOf": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "referenceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "timestamp",
              "value"
            ],
            "properties": {
              "timestamp": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              "value": {
                "type": "number"
              },
              "eventId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "dataStatus": { "const": "verified" } }, "required": ["dataStatus"] },
          "then": { "required": ["asOf", "source", "referenceId"] }
        }
      ]
    },
    "newsPanel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "dataStatus",
        "items"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "type": {
          "const": "news_panel"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "dataStatus": {
          "enum": [
            "demo",
            "verified"
          ]
        },
        "asOf": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "summary",
              "source",
              "publishedAt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "publishedAt": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              "referenceId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "dataStatus": { "const": "verified" } }, "required": ["dataStatus"] },
          "then": {
            "required": ["asOf"],
            "properties": { "items": { "type": "array", "items": { "type": "object", "required": ["referenceId"] } } }
          }
        }
      ]
    },
    "scene3d": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "preset",
        "activation",
        "layers",
        "weights"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "type": {
          "const": "scene_3d"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "preset": {
          "const": "feedforward_network"
        },
        "activation": {
          "enum": [
            "sigmoid",
            "relu",
            "linear"
          ]
        },
        "layers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        },
        "weights": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "number",
                "minimum": -10,
                "maximum": 10
              }
            }
          }
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "controlType",
        "label",
        "actionId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "type": {
          "const": "control"
        },
        "controlType": {
          "enum": [
            "slider",
            "button"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "actionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "value": {
          "type": "number"
        }
      }
    },
    "selectAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "targetComponentId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "type": {
          "const": "select"
        },
        "targetComponentId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        }
      }
    },
    "adjustAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "targetComponentId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "type": {
          "const": "adjust"
        },
        "targetComponentId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        }
      }
    },
    "navigateAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "referenceId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "type": {
          "const": "navigate"
        },
        "referenceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://[^\\s/?#@]+(?:[/?#][^\\s]*)?$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "publishedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    }
  }
}
